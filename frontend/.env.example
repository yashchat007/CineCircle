# Base URL of the CineCircle backend when frontend and backend are hosted separately.
# Leave unset in local development; Vite proxies /api to http://localhost:8080.
# On Vercel, leave unset too: vercel.json proxies /api to the Render backend (same-origin, no CORS).
# Set only for Docker or other hosts where the API is on a different origin.
VITE_API_BASE_URL=
