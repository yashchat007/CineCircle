# Copy these into your environment (or IDE run configuration) before starting the backend.
DATABASE_URL=jdbc:postgresql://localhost:5432/cinecircle
DATABASE_USERNAME=cinecircle
DATABASE_PASSWORD=cinecircle

# At least 32 characters. Use a long random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-chars
JWT_EXPIRATION_HOURS=168

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
